#calculate the area of a rectangle 
#include <stdio.h>

int main()
{
    int length, breadth, area;

    printf("Enter length: ");
    scanf("%d", &length);

    printf("Enter breadth: ");
    scanf("%d", &breadth);

    area = length * breadth;

    printf("Area of rectangle = %d", area);

    return 0;
}
output
Enter length: 10
Enter breadth: 5
Area of rectangle = 50

