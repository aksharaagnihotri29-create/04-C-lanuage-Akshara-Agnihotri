
/* CHECK WHETHER A CHARACTER IS AN ALPHABET OR NOT */

#include <stdio.h>
#include <conio.h>

int main()
{
    char ch;

    printf("Enter a character: ");
    scanf("%c", &ch);

    if((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z'))
    {
        printf("It is an Alphabet");
    }
    else
    {
        printf("It is not an Alphabet");
    }

    getch();
    return 0;
}

/*
OUTPUT:
Enter a character: A
It is an Alphabet
*/


/* SWAP TWO NUMBERS WITHOUT USING THIRD VARIABLE */

#include <stdio.h>
#include <conio.h>

int main()
{
    int a, b;

    printf("Enter two numbers: ");
    scanf("%d%d", &a, &b);

    a = a + b;
    b = a - b;
    a = a - b;

    printf("After swapping: %d %d", a, b);

    getch();
    return 0;
}

/*
OUTPUT:
Enter two numbers: 10 20
After swapping: 20 10
*/


/* SWAP TWO NUMBERS USING THIRD VARIABLE */

#include <stdio.h>
#include <conio.h>

int main()
{
    int a, b, temp;

    printf("Enter two numbers: ");
    scanf("%d%d", &a, &b);

    temp = a;
    a = b;
    b = temp;

    printf("After swapping: %d %d", a, b);

    getch();
    return 0;
}

/*
OUTPUT:
Enter two numbers: 5 10
After swapping: 10 5
*/


/* FIND FACTORIAL OF A NUMBER USING FOR LOOP */

#include <stdio.h>
#include <conio.h>

int main()
{
    int n, i, fact = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    for(i = 1; i <= n; i++)
    {
        fact = fact * i;
    }

    printf("Factorial = %d", fact);

    getch();
    return 0;
}

/*
OUTPUT:
Enter a number: 5
Factorial = 120
*/


