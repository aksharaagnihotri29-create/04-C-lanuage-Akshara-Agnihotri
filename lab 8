/* FIND GCD OF TWO NUMBERS */

#include <stdio.h>
#include <conio.h>

int main()
{
    int a, b, i, gcd = 1;

    printf("Enter two numbers: ");
    scanf("%d%d", &a, &b);

    for(i = 1; i <= a && i <= b; i++)
    {
        if(a % i == 0 && b % i == 0)
        {
            gcd = i;
        }
    }

    printf("GCD = %d", gcd);

    getch();
    return 0;
}

/*
OUTPUT:
Enter two numbers: 12 18
GCD = 6
*/


/* FIND LCM OF TWO NUMBERS */

#include <stdio.h>
#include <conio.h>

int main()
{
    int a, b, max, lcm;

    printf("Enter two numbers: ");
    scanf("%d%d", &a, &b);

    if(a > b)
        max = a;
    else
        max = b;

    lcm = max;

    while(1)
    {
        if(lcm % a == 0 && lcm % b == 0)
        {
            break;
        }

        lcm++;
    }

    printf("LCM = %d", lcm);

    getch();
    return 0;
}

/*
OUTPUT:
Enter two numbers: 4 6
LCM = 12
*/


