/* CHECK WHETHER A NUMBER IS PALINDROME OR NOT USING FOR LOOP */

#include <stdio.h>
#include <conio.h>

int main()
{
    int n, temp, rem, rev = 0, i;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    for(i = n; i > 0; i = i / 10)
    {
        rem = i % 10;
        rev = rev * 10 + rem;
    }

    if(temp == rev)
    {
        printf("Palindrome Number");
    }
    else
    {
        printf("Not a Palindrome Number");
    }

    getch();
    return 0;
}

/*
OUTPUT:
Enter a number: 121
Palindrome Number
*/


/* CHECK WHETHER A NUMBER IS ARMSTRONG OR NOT USING FOR LOOP */

#include <stdio.h>
#include <conio.h>

int main()
{
    int n, temp, rem, sum = 0;
    int count = 0, power, i;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    for(; temp > 0; temp = temp / 10)
    {
        count++;
    }

    temp = n;

    for(; temp > 0; temp = temp / 10)
    {
        rem = temp % 10;
        power = 1;

        for(i = 1; i <= count; i++)
        {
            power = power * rem;
        }

        sum = sum + power;
    }

    if(sum == n)
    {
        printf("Armstrong Number");
    }
    else
    {
        printf("Not an Armstrong Number");
    }

    getch();
    return 0;
}

/*
OUTPUT:
Enter a number: 153
Armstrong Number
*/
