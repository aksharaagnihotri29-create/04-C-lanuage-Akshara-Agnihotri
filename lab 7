/* Largest Among Three Numbers */

#include<stdio.h>
#include<conio.h>

void main()
{
    int a, b, c, largest;
    clrscr();

    printf("Enter three numbers: ");
    scanf("%d%d%d", &a, &b, &c);

    if(a >= b && a >= c)
        largest = a;
    else if(b >= a && b >= c)
        largest = b;
    else
        largest = c;

    printf("Largest = %d", largest);

    getch();
}

/* Output:
Enter three numbers: 10 25 15
Largest = 25
*/


/* Fahrenheit to Celsius */

#include<stdio.h>
#include<conio.h>

void main()
{
    float f, c;
    clrscr();

    printf("Enter Fahrenheit: ");
    scanf("%f", &f);

    c = (f - 32) * 5 / 9;

    printf("Celsius = %.2f", c);

    getch();
}

/* Output:
Enter Fahrenheit: 98.6
Celsius = 37.00
*/


/* Area and Perimeter of Rectangle */

#include<stdio.h>
#include<conio.h>

void main()
{
    float l, b, area, perimeter;
    clrscr();

    printf("Enter length: ");
    scanf("%f", &l);

    printf("Enter breadth: ");
    scanf("%f", &b);

    area = l * b;
    perimeter = 2 * (l + b);

    printf("Area = %.2f\n", area);
    printf("Perimeter = %.2f", perimeter);

    getch();
}

/* Output:
Enter length: 10
Enter breadth: 5
Area = 50.00
Perimeter = 30.00
*/
