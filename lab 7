/* Positive, Negative or Zero using Ternary Operator */

#include<stdio.h>
#include<conio.h>

void main()
{
    int n;
    clrscr();

    printf("Enter a number: ");
    scanf("%d", &n);

    n > 0 ? printf("Positive") : n < 0 ? printf("Negative") : printf("Zero");

    getch();
}

/* Output:
Enter a number: -5
Negative
*/


/* Quotient and Remainder */

#include<stdio.h>
#include<conio.h>

void main()
{
    int a, b, q, r;
    clrscr();

    printf("Enter two numbers: ");
    scanf("%d%d", &a, &b);

    q = a / b;
    r = a % b;

    printf("Quotient = %d\n", q);
    printf("Remainder = %d", r);

    getch();
}

/* Output:
Enter two numbers: 17 5
Quotient = 3
Remainder = 2
*/


